# Copy this file to .env and fill in your real project values.
# Find these in Supabase Dashboard -> Project Settings -> API.
# VITE_SUPABASE_ANON_KEY is safe to expose in the browser (it's the
# public "anon" key, gated by RLS) — but it should still live here,
# not be hardcoded in source, so it's easy to rotate per environment.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
